meanlog = ifelse(Parameter %in% params_qlnorm, Value, NA),
sdlog = ifelse(Parameter %in% params_qlnorm, RSE, NA),
min = ifelse(Parameter %in% params_qlnorm, NA, binf),
max = ifelse(Parameter %in% params_qlnorm, NA, bsup),
Distribution = "qunif")
